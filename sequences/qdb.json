{
  "name": "qdb",
  "display_name": "Цитатник",
  "description": "Башорг для чатов.",
  "version": [1,0,0,0],
  "shortname": "цитаты",
  "triggers": [
    {
      "type": "text_exact",
      "params": ["quote","бот запиши","бот сохрани","сохранить цитату","ахаха жжош сцуко","в цитатник"],
      "subseq": "save_quote"
    },
    {
      "type": "text_exact",
      "params": ["показать цитаты","есть компромат"],
      "subseq": "show_all_quotes"
    },
    {
      "type": "text_exact",
      "params": ["показать цитатник","цитатник чата"],
      "subseq": "show_chat_quotes"
    },
    {
      "type": "text_prefix",
      "params": ["плюсую "],
      "subseq": "quote_upvote",
      "tag": "quotes_list"
    },
    {
      "type": "text_prefix",
      "params": ["цитаты поиск "],
      "subseq": "quote_search_user_tag",
      "tag": "whois_list"
    },
    {
      "type": "text_prefix",
      "params": ["цитаты поиск "],
      "subseq": "quote_search"
    },
    {
      "type": "text_prefix",
      "params": ["плюсую "],
      "subseq": "quote_upvote",
      "tag": "whois_list"
    },
    {
      "type": "text_exact",
      "params": ["ещё"],
      "subseq": "chat_quotes_paginate",
      "tag": "quotes_paginate"
    }
  ],
  "subseqs":
  {
    "save_quote": [
      {
        "action": "qdb_save",
        "params": ["saved_quote_id", "quote_save_result"],
        "target": "reply"
      },
      {
        "action": "concat",
        "params": ["quote_save_", "*quote_save_result", "quote_save_result"]
      },
      {
        "action": "gosub",
        "params": ["*quote_save_result"]
      }
    ],
    "quote_save_ok": [
      {
        "action": "kill_msg",
        "params": [10]
      },
      {
        "action": "emit_text",
        "params": ["save_success",10]
      }
    ],
    "quote_save_no_text": [
      {
        "action": "kill_msg",
        "params": [10]
      },
      {
        "action": "emit_text",
        "params": ["nothing_to_save",10]
      }
    ],
    "quote_save_exists": [
      {
        "action": "qdb_upvote",
        "params": ["*saved_quote_id", 1, "dev_null"]
      },
      {
        "action": "emit_text",
        "params": ["quote_exists",10]
      }
    ],
    "quote_upvote": [
      {
        "action": "get_match",
        "params": ["quote_id"]
      },
      {
        "action": "qdb_upvote",
        "params": ["*quote_id", 1, "new_rating"]
      },
      {
        "action": "if_eq",
        "params": ["*new_rating", -1, "quote_upvote_fail","quote_upvote_ok"]
      }
    ],
    "quote_upvote_ok": [
      {
        "action": "emit_text",
        "params": ["quote_upvoted",10]
      },
      {
        "action": "kill_msg",
        "params": [10]
      }
    ],
    "quote_upvote_fail": [
      {
        "action": "emit_text",
        "params": ["quote_not_upvoted",10]
      },
      {
        "action": "kill_msg",
        "params": [10]
      }
    ],
    "show_all_quotes": [
      {
        "action": "get_uid",
        "params": ["uid_to_fetch"],
        "target": "reply"
      },
      {
        "action": "qdb_get_user",
        "params": ["*uid_to_fetch","user_quotes",-1, "global", 0, "oldest"]
      },
      {
        "action": "get_user",
        "params": ["*uid_to_fetch","userinfo"]
      },
      {
        "action": "count",
        "params": ["user_quotes", "user_quotes_count"]
      },
      {
        "action": "if_eq",
        "params": ["*user_quotes_count",0,"no_quotes_yet","show_user_quotes"]
      },
      {
        "action": "kill_msg",
        "params": [5]
      }
    ],
    "quote_search_user_tag": [
      {
        "action": "get_match",
        "params": ["quote_search"]
      },
      {
        "action": "qdb_search",
        "params": ["*quote_search","user_quotes","*__tag0",-1, "global", 0, "oldest"]
      },
      {
        "action": "get_user",
        "params": ["*__tag0","userinfo"]
      },
      {
        "action": "count",
        "params": ["user_quotes", "user_quotes_count"]
      },
      {
        "action": "if_eq",
        "params": ["*user_quotes_count",0,"no_quotes_yet","show_user_quotes"]
      },
      {
        "action": "kill_msg",
        "params": [5]
      }
    ],
    "quote_search": [
      {
        "action": "get_match",
        "params": ["quote_search"]
      },
      {
        "action": "get_uid",
        "params": ["uid"],
        "target": "reply"
      },
      {
        "action": "if_eq",
        "params": ["*uid","*__bot_uid","self",""]
      },
      {
        "action": "if_eq",
        "params": ["*uid",0,"quote_search_chat","quote_search_user"]
      }
    ],
    "quote_search_user": [

      {
        "action": "qdb_search",
        "params": ["*quote_search","user_quotes","*uid",-1, "global", 0, "oldest"]
      },
      {
        "action": "get_user",
        "params": ["*uid","userinfo"]
      },
      {
        "action": "count",
        "params": ["user_quotes", "user_quotes_count"]
      },
      {
        "action": "if_eq",
        "params": ["*user_quotes_count",0,"no_quotes_yet","show_user_quotes"]
      },
      {
        "action": "kill_msg",
        "params": [5]
      }
    ],
    "quote_search_chat": [

      {
        "action": "qdb_search",
        "params": ["*quote_search","user_quotes",-1,-1, "local", 0, "oldest"]
      },
      {
        "action": "get_user",
        "params": ["*__tag0","userinfo"]
      },
      {
        "action": "count",
        "params": ["user_quotes", "user_quotes_count"]
      },
      {
        "action": "if_eq",
        "params": ["*user_quotes_count",0,"no_quotes_yet_chat","show_chat_search"]
      },
      {
        "action": "kill_msg",
        "params": [5]
      }
    ],
    "no_quotes_yet": [
      {
        "action": "emit_text",
        "params": ["no_quotes_found", 10]
      }
    ],
    "show_user_quotes": [
      {
        "action": "fmt_list",
        "params": ["user_quotes","user_quotes_format","quote_list"]
      },
      {
        "action": "emit_text",
        "params": ["user_quotes_template",60]
      },
      {
        "action": "tag_msg",
        "params": ["quotes_list",-1]
      }
    ],
    "no_quotes_yet_chat": [
      {
        "action": "emit_text",
        "params": ["no_quotes_found", 10]
      }
    ],
    "show_chat_search": [
      {
        "action": "fmt_list",
        "params": ["user_quotes","chat_quotes_format","chat_quote_list"]
      },
      {
        "action": "emit_text",
        "params": ["chat_quotes_template",60]
      },
      {
        "action": "tag_msg",
        "params": ["quotes_list",-1]
      }
    ],
    "show_chat_quotesxx": [
      {
        "action": "emit_text",
        "params": ["no_quotes", 10]
      }
    ],
    "chat_quotes_paginate": [
      {
        "action": "add",
        "params": ["*__tag0",1,"chat_quote_page"]
      },
      {
        "action": "qdb_get_chat",
        "params": ["chat_quotes",10, "*chat_quote_page", 1, "score"]
      },
      {
        "action": "count",
        "params": ["chat_quotes", "chat_quotes_count"]
      },
      {
        "action": "if_eq",
        "params": ["*chat_quotes_count",0,"last_page_chat",""]
      },
      {
        "action": "call",
        "params": ["show_chat_quotes_page"]
      }
    ],
    "show_chat_quotes": [
      {
        "action": "qdb_get_chat",
        "params": ["chat_quotes",10, 1, 1, "score"]
      },
      {
        "action": "count",
        "params": ["chat_quotes", "chat_quotes_count"]
      },
      {
        "action": "if_eq",
        "params": ["*chat_quotes_count",0,"no_chat_quotes_yet",""]
      },
      {
        "action": "add",
        "params": [0,1,"chat_quote_page"]
      },
      {
        "action": "call",
        "params": ["show_chat_quotes_page"]
      }
    ],
    "show_chat_quotes_page": [
      {
        "action": "fmt_list",
        "params": ["chat_quotes","chat_quotes_format","chat_quote_list"]
      },
      {
        "action": "emit_text",
        "params": ["chat_quotes_template",60]
      },
      {
        "action": "tag_msg",
        "params": ["quotes_list",-1,1]
      },
      {
        "action": "tag_msg",
        "params": ["quotes_paginate",-1,"*chat_quote_page"]
      },
      {
        "action": "kill_msg",
        "params": [5]
      }
    ],
    "no_chat_quotes_yet": [
      {
        "action": "emit_text",
        "params": ["chat_no_quotes", 10]
      },
      {
        "action": "kill_msg",
        "params": [5]
      }

    ],
    "last_page_chat": [
      {
        "action": "emit_text",
        "params": ["chat_last_page", 10]
      },
      {
        "action": "kill_msg",
        "params": [5]
      }

    ],
    "qdb_save_no_target": [
      {
        "action": "emit_text",
        "params": ["no_target",10]
      }
    ]
  },
  "stringpools": {
    "save_success": [
      "Цитата сохранена под номером {saved_quote_id}\\!"
    ],
    "nothing_to_save": [
      "Тут нечего сохранять\\."
    ],
    "no_target": [
      "Эту команду нужно писать в ответ на сообщение, которое нужно сохранить\\."
    ],
    "quote_exists": [
      "Эту цитату уже сохранили\\. Цитата №{saved_quote_id} получает \\+1 к рейтингу\\."
    ],
    "quote_upvoted": [
      " Цитата №{quote_id} получает \\+1 к рейтингу\\. Теперь у цитаты {new_rating} плюсов\\."
    ],
    "quote_not_upvoted": [
      "Цитаты под номером №{quote_id} не существует\\.",
      "А вот хуй тебе\\, а не цитата\\."
    ],
    "no_quotes": [
      "На этого человека компромата ещё нет\\."
    ],
    "user_quotes_template": [
      "За пользователем **{userinfo.current_nick}** были записаны следующие цитаты:{quote_list}"
    ],
    "chat_quotes_template": [
      "{chat_quote_list}"
    ],
    "chat_no_quotes": [
      "Тут ничего нет ещё да\\."
    ],
    "no_quotes_found": [
      "Не найдено\\."
    ],
    "chat_last_page": [
      "Больше нету\\, ещё насохраняйте\\!"
    ],
    "user_quotes_format": [
      "\n*[№{0.id}](https://t.me/c/{0.real_chat_id}/{0.message_id})*    \\| {0.rating} \\+\n\\<\\=\\=\\=\\=\\=\\=\\=\\=\\=\\=\\=\\=\\=\n{0.text_raw}\n\\=\\=\\=\\=\\=\\=\\=\\=\\=\\=\\=\\=\\=\\>\u2029"
    ],
    "chat_quotes_format": [
      "\n*[№{0.id}](https://t.me/c/{0.real_chat_id}/{0.message_id})* {0.user_nick}    \\| {0.rating} \\+\n\\<\\=\\=\\=\\=\\=\\=\\=\\=\\=\\=\\=\\=\\=\n{0.text_raw}\n\\=\\=\\=\\=\\=\\=\\=\\=\\=\\=\\=\\=\\=\\>"
    ]
  },
  "helptopics": {
    "_": "Этот модуль позволяет сохранять цитаты\\. Напишите \\\"бот запиши\\\" в ответ на сообщение\\, и оно будет сохранено в цитатнике\\, вместе с контекстом \\(т\\.е\\.\\, будет сохранено сообщение\\, на которое отвечает сохраняемое сообщение\\)\\,\nСохраняется только текст сообщения\\, включая текст к картинке\\. Также учитывается\\, в каком чате была сохранена цитата\\, когда и кто сохранил\\. \n*Команды\\:*\n\n`бот запиши` \\- записать цитату\\, ответом на сообщение\\.\n\n`показать цитаты` \\- показать все цитаты пользователя\\, ответом на сообщение\\.\n\n`цитатник чата` \\- показывает цитаты\\, записанные в чате\\, сортировка по рейтингу\\.\n\n`ещё` \\- ответом на сообщение с цитатами чата\\, выдаёт следующую страницу\\.\n\n`цитаты поиск _текст_` \\- поиск по цитатам\\, если ответом на сообщение\\, то ищет в цитатах пользователя\\, иначе \\- ищет во всех цитатах чата\\.\n\n`плюсую _номер_` \\- повышает рейтинг цитаты с номером\\, ответом на сообщение с цитатами\\."
  }
}
