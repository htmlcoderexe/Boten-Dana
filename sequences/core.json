    "help_topics_list_format":  ["\\\"{0}\\\"\n"],
    "help_modules_all": ["Загружены следующие модули\\, вот команды для получения справки: \n\\(цифры указывают количество файлов справки\\)\\:\n\n{seqlist}"],
    "help_modules_list_format": ["*{0.display_name}* \\\"`бот справка {0.helpname}`\\\" {0.topic_count} \n"],
    "chat_subscribed": ["Новости бота *вкл\\.*\nПри обновлении бота будет отправлено сообщение прямо в чат\\. Администраторы чата могут отключить подписку командой /news\\_subscribe и нажатием соответствующей кнопки\\."],
    "chat_not_subscribed": ["Новости бота *выкл\\.*\nДля получения сообщений об обновлении бота прямо в чат\\, администраторы чата могут включить подписку командой /news\\_subscribe и нажатием соответствующей кнопки\\."],
    "news_subscribed_ok": ["Подписка на обновления включена\\."],
    "news_unsubscribed_ok": ["Подписка на обновления выключена\\."]
  },
    "config_vars": [
    {
      "name": "pizda_frequency",
      "display_name": "Шанс срабатывания пизды2",
      "default": "0.2"
    },
    {
      "name": "std_delay",
      "display_name": "Шанс срабатывания пизды3",
      "default": "0.2"
    }
  ],
  "helptopics": {
    "_": "Это \\- главный модуль бота\\. Он поддерживает функцию плюсования \\(пепяка\\)\\, чистит команды за пользователями \\(только те\\, которые с \\/\\)\\, а ещё можно отменить удаление сообщения от бота\\, которое было бы автоматически удалено\\. \nПоследнее можно сделать\\, написав одну из следующих команд в ответ на сообщение\\: \n\\\"бот придержи\\\"\\,\\\"бот оставь\\\"\\,\\\"бот не удаляй\\\"\\. Также есть команда /status \\- на данный момент там ироткр техническая информация\\.",
    "пепяка": "Пепяка \\- это что\\-то типа репутации или кармы пользователя\\. Её можно только дать другому пользователю\\, написав \\+ в ответ на сообщение пользователя\\."
  }
}
