{
  "name": "core",
  "display_name": "Базовые функции",
  "description": "Базовые функции бота.",
  "shortname": "бот",
  "version": [1,0,0,0],
  "triggers": [
    {
      "type": "text_exact",
      "params": ["+"],
      "subseq": "upvote_user"
    },
    {
      "type": "text_exact",
      "params": ["дана ну какого хуя","дана какого хуя","бот какого хуя","бот ну какого хуя","какого хуя дана"],
      "subseq": "bot_wtf"
    },
    {
      "type": "text_prefix",
      "params": ["/"],
      "subseq": "clean_command",
      "raw": "yes"
    },
    {
      "type": "text_exact",
      "params": ["бот справка","бот хелп"],
      "subseq": "help_show_all"
    },
    {
      "type": "text_prefix",
      "params": ["бот справка "],
      "subseq": "get_help"
    },
    {
      "type": "text_exact",
      "params": ["бот придержи","бот оставь","бот не удаляй"],
      "subseq": "cancel_kill",
      "target": "reply"
    },
    {
      "type": "text_contains",
      "params": ["доминант","доминир","доминат"],
      "subseq": "dominating"
      }
  ],
  "commands":
    {
      "status":
      {
        "description": "Показать статус бота.",
        "subseq": "show_status"
      },
      "news_subscribe":
      {
        "description": "Подписка на новости бота.",
        "subseq": "whatsnew"
      },
      "help":
      {
        "description": "Справка по функциям бота.",
        "subseq": "help_show_all"
      },
      "sbtest":
      {
        "description": "scoreboard_test",
        "subseq": "scoreboard_test"
      }
    }
  ,
  "buttons": {
    "test": "test_button",
    "test2": "test_button2",
    "news_subscribe": "news_subscribe",
    "news_unsubscribe": "news_unsubscribe"
  },
  "subseqs": {
    "get_help":
    [
      {
        "action": "kill_msg",
        "params": [10]
      },
      {
        "action": "get_match",
        "params": ["helptopic"]
      },
      {
        "action": "get_help",
        "params": ["*helptopic","help_out"]
      },
      {
        "action": "obj_read",
        "params": ["help_out","result_type","result"]
      },
      {
        "action": "if_eq",
        "params": ["*result","none","help_404",""]
      },
      {
        "action": "obj_read",
        "params": ["help_out","content","main_help"]
      },
      {
        "action": "obj_read",
        "params": ["help_out","moduletopic","modulecode"]
      },
      {
        "action": "obj_read",
        "params": ["help_out","modulename","modulename"]
      },
      {
        "action": "escape",
        "params": ["*modulename","modulename"]
      },
      {
        "action": "if_eq",
        "params": ["*result","module_only","help_main",""]
      },
      {
        "action": "if_eq",
        "params": ["*result","module_topics","help_main_list",""]
      },
      {
        "action": "if_eq",
        "params": ["*result","topic","help_topic",""]
      }
    ],
    "help_list":
    [

    ],
    "bot_wtf":
    [
      {
        "action": "emit_text",
        "params": ["bot_wtf",-1]
      }

    ],
    "help_main":
    [
      {
        "action": "emit_text",
        "params": ["help_module",60]
      }
    ],
    "help_404":
    [
      {
        "action": "emit_text",
        "params": ["help_404",60]
      }
    ],
    "help_topic":
    [
      {
        "action": "obj_read",
        "params": ["help_out","topic","topicname"]
      },
      {
        "action": "emit_text",
        "params": ["help_module_topic",60]
      }
    ],
    "help_main_list":
    [
      {
        "action": "obj_read",
        "params": ["help_out","topiclist","topics"]
      },
      {
        "action": "fmt_list",
        "params": ["topics","help_topics_list_format","helplist"]
      },
      {
        "action": "emit_text",
        "params": ["help_module_with_topics",60]
      }
    ],
    "help_show_all": [
      {
        "action": "kill_msg",
        "params": [10]
      },
      {
        "action": "get_seqs",
        "params": ["loaded_seqs"]
      },
      {
        "action": "fmt_list",
        "params": ["loaded_seqs","help_modules_list_format","seqlist"]
      },
      {
        "action": "emit_text",
        "params": ["help_modules_all",60]
      }
    ],
    "test_button":
    [
      {
        "action": "msgbox",
        "params": ["ты хуй"]
      }
    ],
    "test_button2":
    [
      {
        "action": "msgbox",
        "params": ["*__button_owner"]
      }
    ],
    "dominating":
      [
        {
          "action": "fetch_pool",
          "params": ["dominating_pool","dominate"]
        },
        {
          "action": "emit_saved_message",
          "params": ["*dominate",-1,"dominating",-1]
        }
      ],
    "scoreboard_test":
      [
        {
          "action": "scoreboard",
          "params": ["dontcare",-1,"all",-1,20,"rep","mat","voice"]
        },
        {
          "action": "fmt_list",
          "params": ["dontcare","test_board_fmt","top"]
        },
        {
          "action": "add_button",
          "params": ["хуй","test"]
        },
        {
          "action": "add_button",
          "params": ["хуй 2","test2"]
        },
        {
          "action": "add_button",
          "params": ["хуй 3","6666"]
        },
        {
          "action": "emit_text",
          "params": ["test_board",15]
        }
      ],
    "show_status": [
      {
        "action": "kill_msg",
        "params": [60]
      },
      {
        "action": "get_seqs",
        "params": ["loaded_seqs"]
      },
      {
        "action": "fmt_list",
        "params": ["loaded_seqs","seq_short_fmt","seqlist"]
      },
      {
        "action": "emit_text",
        "params": ["seqlist",60]
      }
    ],
    "clean_command": [
      {
        "action": "kill_msg",
        "params": [60]
      }

    ],
    "cancel_kill": [
      {
        "action": "keep_msg",
        "params": [""],
        "target": "reply"
      },
      {
        "action": "gosub",
        "params": ["cancel_kill_success"]
      }
    ],
    "cancel_kill_success": [
      {
        "action": "kill_msg",
        "params": [5]
      },
      {
        "action": "emit_text",
        "params": ["cancel_kill_success",15]
      }
    ],
    "cancel_no_target": [
      {
        "action": "kill_msg",
        "params": [5]
      },
      {
        "action": "emit_text",
        "params": ["cancel_kill_no_target",15]
      }

    ],
    "cancel_no_kill": [

    ],
    "whatsnew":
    [
      {
        "action": "userlist_check",
        "params": ["*__chat_id","news_subscribers","subscribed"]
      },
      {
        "action": "get_admin",
        "params": []
      },

      {
        "action": "if_eq",
        "params": ["*__is_admin",true,"**news_subscribe_buttons",""]
      },
      {
        "action": "if_eq",
        "params": ["*subscribed",true,"news_show_subscribed","news_show_not_subscribed"]
      }

    ],
    "news_subscribe_buttons": [
        {
          "action": "add_button",
          "params": ["Вкл.","news_subscribe"]
        },
        {
          "action": "add_button",
          "params": ["Выкл.","news_unsubscribe"]
        }

    ],
    "news_show_subscribed": [
      {
        "action": "emit_text",
        "params": ["chat_subscribed",30]
      }
    ],
    "news_show_not_subscribed": [
      {
        "action": "emit_text",
        "params": ["chat_not_subscribed",30]
      }
    ],
    "news_subscribe": [
      {
        "action": "if_eq",
        "params": ["*__button_owner","*__uid","","pref_not_u"]
      },
      {
        "action": "userlist_add",
        "params": ["*__chat_id", "news_subscribers"]
      },
      {
        "action": "msgbox",
        "params": ["ok"]
      },
      {
        "action": "kill_msg",
        "params": [0,"*__button_msg"]
      },
      {
        "action": "emit_text",
        "params": ["news_subscribed_ok",15]
      }
    ],
    "news_unsubscribe": [
      {
        "action": "if_eq",
        "params": ["*__button_owner","*__uid","","pref_not_u"]
      },
      {
        "action": "userlist_remove",
        "params": ["*__chat_id", "news_subscribers"]
      },
      {
        "action": "msgbox",
        "params": ["ok"]
      },
      {
        "action": "kill_msg",
        "params": [0,"*__button_msg"]
      },
      {
        "action": "emit_text",
        "params": ["news_unsubscribed_ok",15]
      }
    ],
    "upvote_user": [
      {
        "action": "get_uid",
        "params": ["upvoter"]
      },
      {
        "action": "get_uid",
        "params": ["upvotee"],
        "target": "reply"
      },
      {
        "action": "if_eq",
        "params": ["*upvotee",0,"upvote_no_target","upvote_proceed"]
      }
    ],
    "upvote_proceed": [
      {
        "action": "concat",
        "params": ["upvoteduser_","*upvotee","upvoterscore"]
      },
      {
        "action": "concat",
        "params": ["upvotedbyuser_","*upvoter","upvoteescore"]
      },
      {
        "action": "score_up",
        "params": [
          "*upvotee",
          "rep",
          1,
          "upvotee_new_rep"
        ]
      },
      {
        "action": "concat",
        "params": ["\\","*upvotee_new_rep","upvotee_new_rep"]
      },
      {
        "action": "score_up",
        "params": ["*upvotee","*upvoteescore",1,"dev_null"]
      },
      {
        "action": "score_up",
        "params": ["*upvoter","*upvoterscore",1,"dev_null"]
      },
      {
        "action": "score_up",
        "params": ["*upvoter","upvotes_given",1,"dev_null"]
      },
      {
        "action": "get_user",
        "params": ["*upvotee","upvotee_info"]
      },
      {
        "action": "obj_read",
        "params": ["upvotee_info","current_nick","usertag"]
      },
      {
        "action": "emit_text",
        "params": ["upvote_success",15]
      }
    ]
  },
  "stringpools": {
    "upvote_success": [
        " [{usertag}](tg://user?id={upvotee}) получает плюс и теперь имеет {upvotee_new_rep} совершенно бесполезных очков",
        " [{usertag}](tg://user?id={upvotee}) получает плюс и теперь имеет {upvotee_new_rep} совершенно бесполезных очков",
        " [{usertag}](tg://user?id={upvotee}) получает плюс и теперь имеет {upvotee_new_rep} совершенно бесполезных очков",
        " [{usertag}](tg://user?id={upvotee}) получает плюс и теперь имеет {upvotee_new_rep} совершенно бесполезных очков",
        " [{usertag}](tg://user?id={upvotee}) получает плюс и теперь имеет {upvotee_new_rep} совершенно бесполезных очков",
        " [{usertag}](tg://user?id={upvotee}) получает плюс и теперь имеет {upvotee_new_rep} совершенно бесполезных очков",
        " [{usertag}](tg://user?id={upvotee}) получает плюс и теперь имеет {upvotee_new_rep} совершенно бесполезных очков",
        "У [{usertag}](tg://user?id={upvotee}) теперь {upvotee_new_rep} пепяки, и это круто \\(нет\\)",
        "Эй\\, [{usertag}](tg://user?id={upvotee})\\, у тебя уже {upvotee_new_rep} плюсов\\, можешь начинать гордиться",
        "[{usertag}](tg://user?id={upvotee}) получает хуй в ро\\.\\.\\. плюс и теперь имеет {upvotee_new_rep} совершенно бесполезных очков"
    ],
    "cancel_kill_success": [
      "Ок\\!"
    ],
    "cancel_kill_no_target": [
      "Нужно писать это в ответ на сообщение\\, которое боту нужно не удалять\\."
    ],
    "seqlist": [
      "Загружены следующие модули\\:\n{seqlist}"
    ],
    "seq_short_fmt": [
      "*{0.display_name}* v{0.version} \n\"_{0.description}_\"\n"
    ],
    "test_board": [
      "```\nпепяка   маты   войс  имя \n{top}```"
    ],
    "bot_wtf": [
      "А никакого\\. Нефиг ковыряться было в боте в три часа ночи\\.",
