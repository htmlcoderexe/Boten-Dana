      "\\{0[1]:6d} \\{0[2]:6d} \\{0[3]:6d} {0[0]: <13.13}\n"
    ],
    "domin8":["*DOMINATING!*"],
    "help_main": ["Найдена справка по следующим модулям\\, для вызова справки по модулю напишите \\\"бот справка *название справки*\\\","],
    "help_module": ["*Справка по модулю \\\"{modulename}\\\"*\n{main_help}"],
    "help_module_with_topics": ["*Справка по модулю \\\"{modulename}\\\"*\n\n{main_help}\n\n*Дополнительная информация*\n\nТакже найдены следующие темы справки\\, напишите \\\"бот справка {modulecode} *название справки*\\\" для просмотра\\.\n\n{helplist}"],
    "help_module_topic": ["*Справка по модулю \\\"{modulename}\\\"\\>{topicname}*\n\n{main_help}"],
